// Common parameter
earlycon=sbi
console=ttyS0,115200
init=/init
bootdelay=0
baudrate=115200
loglevel=loglevel=8
stderr=serial
stdin=serial,usbkbd
stdout=serial

//partitions/mtdparts/mtdids would set while flashing env.bin

// Nand flash rootfs device
nand_root=ubi0:rootfs
nand_rootfstype=ubifs

// Nor flash rootfs device
nor_root=/dev/mtdblock6
nor_rootfstype=squashfs

// eMMC/SDCard rootfs device
mmc_rootfstype=ext4

// Get "rootfs" partition number in decimal, and set var "mmc_root"
// Variable "boot_devnum" is set during board_lat_init()
set_mmc_root=part number mmc ${boot_devnum} rootfs rootfs_part; \
             setexpr rootfs_part ${rootfs_part} + 0; \
             setenv mmc_root "/dev/mmcblk${boot_devnum}p${rootfs_part}";

set_nvme_root=part number nvme ${boot_devnum} rootfs rootfs_part; \
             setexpr rootfs_part ${rootfs_part} + 0; \
             setenv nvme_root "/dev/nvme${boot_devnum}n1p${rootfs_part}";

// NFS device
ipaddr=192.168.1.15
netmask=255.255.255.0
serverip=10.0.92.134
gatewayip=192.168.1.1
net_data_path=spacemit_flash_file/net_flash_file/

preboot=
knl_addr=0x40000000
knl_name=Image.itb
dtb_addr=
mdio_intf=
phyaddr0=1
phy_link_time=10000
netdev=eth0
nfsopts=
nfs_root=
nfs_bootfile=


// mtdids,mtdparts would be added automatically, it should not add at env.txt

// Common boot args
commonargs=setenv bootargs earlycon=${earlycon} earlyprintk console=${console} ${loglevel} clk_ignore_unused rdinit=${init}

// spinand_ubifs boot
ubifs_list= mtd list; \
             ubifsls;
ubifs_loadimg=  echo " ubifsload Image.itb..."; \
                ubifsload ${knl_addr} ${knl_name};

ubifs_boot=echo "Trying to boot from UBIFS..."; \
           run ubifs_loadimg; \
           bootm ${knl_addr};

// Nand boot
nand_boot=echo "Try to boot from nand flash..."; \
		  run ubifs_list; \
		  run ubifs_loadimg; \
		  bootm ${knl_addr};

// Nor boot
nor_args=run commonargs; \
         run set_nvme_root; \
         setenv bootargs ${bootargs} mtdparts=${mtdparts} root=/dev/nvme${boot_devnum}n1p${rootfs_part} rootfstype=ext4

nor_loadknl=fatload ${bootfs_devname} ${boot_devnum}:${bootfs_part} ${knl_addr} ${knl_name};

nor_boot=echo "Try to boot from blk device ..."; \
         run nor_args; \
         run nor_loadknl; \
         bootm ${knl_addr};\
         echo "########### boot kernel failed by default config, check your boot config #############"

//###############################################################################
// eMMC/SDCard boot
//###############################################################################
set_mmc_args=setenv bootargs "${bootargs}" root=${mmc_root} rootwait rootfstype=${mmc_rootfstype};

mmc_loadknl=echo "load kernel ...";fatload mmc ${boot_devnum}:${bootfs_part} ${knl_addr} ${knl_name};

// Get "dtb" partition start lba and partition size, and load dtb image
mmc_dtb_env=part start mmc ${boot_devnum} dtb dtb_lba; \
            part size mmc ${boot_devnum} dtb dtb_size;

mmc_loaddtb=run mmc_dtb_env; mmc read ${dtb_addr} ${dtb_lba} ${dtb_size};

// Do mmc boot
// define bootargs, load kernel method and bootm method
custom_mmc_commonargs=setenv bootargs earlycon=sbi earlyprintk console=ttyS0,115200 loglevel=8 clk_ignore_unused rdinit=${init} root=/dev/mmcblk1p6 rootwait rootfstype=ext4
custom_mmc_loadknl=fatload mmc ${boot_devnum}:${bootfs_part} ${knl_addr} ${knl_name};
custom_mmc_runknl=bootm ${knl_addr};

mmc_boot=echo "Try to boot from MMC..."; \
         run custom_mmc_commonargs; \
         run custom_mmc_loadknl; \
         run custom_mmc_runknl;\
         echo "############# boot kernel failed, check your boot config ##################"

mmc_boot_default=echo "Try to boot from MMC..."; \
         run commonargs; \
         run set_mmc_root; \
         run set_mmc_args; \
         run mmc_loadknl; \
         bootm ${knl_addr};\
         echo "########### boot kernel failed by default config, check your boot config #############"

try_mmc=run mmc_boot; \
        run mmc_boot_default;

// NFS boot args
nfs_args=run commonargs; setenv bootargs ${bootargs} root=/dev/nfs nfsroot=${serverip}:${nfs_root},${nfsopts}
addip=setenv bootargs ${bootargs} ip=${ipaddr}:${serverip}:${gatewayip}:${netmask}:${hostname}:${netdev}:off
nfs_boot=echo Booting from NFS..; run nfs_args; run addip; tftp ${knl_addr} ${nfs_bootfile} && bootm ${knl_addr}

// U-boot autoboot script: try to boot from device, if failed then try nfs boot
// Variable "boot_device" is set during board_late_init()
autoboot=if test ${boot_device} = nand; then \
                run nand_boot; \
        elif test ${boot_device} = nor; then \
                run nor_boot; \
        elif test ${boot_device} = mmc; then \
                run try_mmc; \
        fi; \
        run nfs_boot;
bootcmd=run autoboot; echo "run autoboot"

// Boot menu definitions
boot_default=echo "Current Boot Device: ${boot_device}"
flash_default=echo "Returning to Boot Menu..."
spacemit_flashing_usb=echo "recovery from usb...... "; \
					  spacemit_flashing usb;
spacemit_flashing_mmc=echo "recovery from mmc...... " \
					  spacemit_flashing mmc;
spacemit_flashing_net=echo "recovery from net...... " \
					  spacemit_flashing net;

bootmenu_delay=5
bootmenu_0="-------- Boot Options --------"=run boot_default
bootmenu_1="Boot from Nor"=run nor_boot
bootmenu_2="Boot from Nand"=run nand_boot
bootmenu_3="Boot from MMC"=run try_mmc
bootmenu_4="Autoboot"=run autoboot
bootmenu_5="Show current Boot Device"=run boot_default
bootmenu_6="-------- Flash Options --------"=run flash_default
bootmenu_7="recovery from usb"=run spacemit_flashing_usb
bootmenu_8="recovery from mmc"=run spacemit_flashing_mmc
bootmenu_9="recovery from net"=run spacemit_flashing_net


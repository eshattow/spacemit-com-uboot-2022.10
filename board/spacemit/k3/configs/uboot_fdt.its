/dts-v1/;
/ {
	description = "U-boot FIT image for k3";
	#address-cells = <2>;
	fit,fdt-list = "of-list";

	images {
		uboot {
			description = "U-Boot";
			type = "standalone";
			os = "u-boot";
			arch = "riscv";
			compression = "none";
			load = <0x1 0x02000000>;
			data = /incbin/("../u-boot-nodtb.bin");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_1 {
			description = "k3_fpga.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_fpga_1x1.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_2 {
			description = "k3_evb.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_evb.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_3 {
			description = "k3_deb1.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_deb1.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_4 {
			description = "k3_com260.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_com260.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_5 {
			description = "k3_dc_board.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_dc_board.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_6 {
			description = "k3_com260_kit_v02.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_com260_kit_v02.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_7 {
			description = "k3_gemini_c0.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_gemini_c0.dtb");
			hash-1 {
				algo = "crc32";
			};
		};

		fdt_8 {
			description = "k3_gemini_c1.dtb";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_gemini_c1.dtb");
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "conf_1";
		conf_1 {
			description = "k3_fpga";
			loadables = "uboot";
			fdt = "fdt_1";
		};

		conf_2 {
			description = "k3_evb";
			loadables = "uboot";
			fdt = "fdt_2";
		};

		conf_3 {
			description = "k3_deb1";
			loadables = "uboot";
			fdt = "fdt_3";
		};

		conf_4 {
			description = "k3_com260";
			loadables = "uboot";
			fdt = "fdt_4";
		};

		conf_5 {
			description = "k3_dc_board";
			loadables = "uboot";
			fdt = "fdt_5";
		};

		conf_6 {
			description = "k3_com260_kit_v02";
			loadables = "uboot";
			fdt = "fdt_6";
		};

		conf_7 {
			description = "k3_gemini_c0";
			loadables = "uboot";
			fdt = "fdt_7";
		};

		conf_8 {
			description = "k3_gemini_c1";
			loadables = "uboot";
			fdt = "fdt_8";
		};
	};
};

#!/usr/bin/make -f

export ARCH=riscv

# The package is riscv64-only, so always default to the riscv64 cross
# toolchain. ?= keeps it overridable from the environment: scripts/build.sh
# passes the SpacemiT vendor toolchain (riscv64-unknown-linux-gnu-) instead.
export CROSS_COMPILE ?= riscv64-linux-gnu-

# Check whether inside a Git repository and get the commit ID
GIT_INSIDE := $(shell git rev-parse --is-inside-work-tree 2>/dev/null)
ifeq ($(GIT_INSIDE),true)
	COMMIT_ID := $(shell git rev-parse --short HEAD)
endif

%:
	dh $@

override_dh_auto_build:
	make k3_defconfig
	make -j$(nproc)
	cp -f u-boot-env-default.bin env.bin

override_dh_gencontrol:
	echo "misc:CommitId=${COMMIT_ID}" >> debian/u-boot-spacemit.substvars
	echo "misc:CommitId=${COMMIT_ID}" >> debian/u-boot-spl-spacemit.substvars
	dh_gencontrol

override_dh_auto_test-indep:

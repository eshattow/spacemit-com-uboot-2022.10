# U-Boot secure fragment for Spacemit K3
#
# Usage: overlay this fragment on top of k3_defconfig to build the
# secure (OP-TEE) variant, e.g.:
#
#   make ARCH=riscv k3_defconfig
#   scripts/kconfig/merge_config.sh -m .config configs/k3_sec.config
#   make ARCH=riscv CROSS_COMPILE=...
#
# Do NOT enable these options in k3_defconfig: the non-secure base
# build must stay OP-TEE-free. The secure build is produced by the
# `uboot_sec` top-level target which merges this fragment.

CONFIG_SPACEMIT_SECURE_BOARD=y

# Selecting SPACEMIT_SECURE_BOARD auto-selects CONFIG_RISCV_OPTEE_SUPPORT
# (OP-TEE DTS nodes + k3-optee FDT fixup).

# Secure (optee partition) MTD layout for SPI NOR/NAND:
# esos@704K/1M, opensbi@1728K/320K, optee@2048K/512K, uboot@2560K.
# Overrides the non-secure layout baked into k3_defconfig.
CONFIG_MTDPARTS_DEFAULT="d420c000.spi:128K@0(bootinfo),512K@128K(fsbl),64K@640K(env),1M@704K(esos),320K@1728K(opensbi),512K@2048K(optee),-@2560K(uboot)"

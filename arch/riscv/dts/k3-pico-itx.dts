#include "k3.dtsi"
#include "k3-pinctrl.dtsi"
#include <dt-bindings/usb/pd.h>

/ {
	model = "spacemit k3 pico itx board";
};

&cpus {
	timebase-frequency = <24000000>;
	clocks = <&ccu CLK_TOP_DCLK>,
		 <&ccu CLK_AXICLK>,
		 <&ccu CLK_CCI550>,
		 <&ccu CLK_CPU_C0_CORE>,
		 <&ccu CLK_CPU_C1_CORE>,
		 <&ccu CLK_CPU_C2_CORE>,
		 <&ccu CLK_CPU_C3_CORE>,
		 <&ccu CLK_PLL3>,
		 <&ccu CLK_PLL4>,
		 <&ccu CLK_PLL5>,
		 <&ccu CLK_PLL8>,
		 <&ccu CLK_PLL3_D1>,
		 <&ccu CLK_CPU_C1_PLL_SRC>,
		 <&ccu CLK_PLL5_D1>,
		 <&ccu CLK_CPU_C3_PLL_SRC>;
	clock-names = "topd", "axi", "cci", "cluster0", "cluster1", "cluster2", "cluster3",
		       "pll3", "pll4", "pll5", "pll8", "pll_src3", "clt1_pll_src", "pll_src5", "clt3_pll_src";
	topd_frequency = <800000000>;
	axi_frequency =  <307000000>;
	cci_frequency =  <1228000000>;
	cluster0_frequency = <2200000000>;
	cluster1_frequency = <2200000000>;
	cluster2_frequency = <1800000000>;
	cluster3_frequency = <1800000000>;
};

&pinctrl {
	pinctrl-single,gpio-range = <
		&range GPIO_89  1 (MUX_MODE0 | EDGE_NONE | PULL_UP   | PAD_DS4)
	>;

	gmac0_grp {
		power-source = <1800>;
	};

	pcie0_1_grp {
		pinctrl-single,pins =<
			K3_PADCONF(GPIO_79, MUX_MODE5, (EDGE_NONE | PULL_UP | PAD_DS15))
			K3_PADCONF(GPIO_81, MUX_MODE5, (EDGE_NONE | PULL_UP | PAD_DS15))
		>;

		power-source = <1800>;
	};

	pcie1_1_grp {
		pinctrl-single,pins =<
			K3_PADCONF(GPIO_88, MUX_MODE4, (EDGE_NONE | PULL_UP | PAD_DS4)) /* PCIeB_perstn */
			K3_PADCONF(GPIO_90, MUX_MODE4, (EDGE_NONE | PULL_UP | PAD_DS4)) /* PCIeB_clkreqn */
		>;
		power-source = <1800>;
	};

	espi0_grp {
		power-source = <1800>;
	};

	usb30_drd_dir_0_cfg: usb30_drd_dir-0-cfg {
		pinctrl-single,pins =<
			K3_PADCONF(GPIO_86, MUX_MODE6, (EDGE_NONE | PULL_UP | PAD_DS8)) /* usb30 drd dir */
		>;
		power-source = <1800>;
	};
};

&gpio{
	gpio-ranges = <
		&pinctrl 89 GPIO_89 1
	>;
};

&uart0 {
	status = "okay";
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1_3>;
	status = "okay";

	tcpc@25 {
		compatible = "fcs,fusb301";
		reg = <0x25>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 2500, PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 1400, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <15000000>;
			self-powered;
		};
	};
};

&i2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2_1>;
	status = "okay";

	eeprom@50{
		compatible = "atmel,24c02";
		reg = <0x50>;
		status = "okay";
	};
};

&eth0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gmac0>;

	phy-reset-pin = <15>;
	max-speed = <1000>;
	clk_tuning_enable;
	clk-tuning-by-delayline;

	tx-phase = <73>;
	rx-phase = <61>;

	phy-mode = "rgmii";
	phy-handle = <&rgmii0>;

	status = "okay";

	mdio {
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		rgmii0: phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			reg = <0x1>;
		};
	};
};

&pcie_phy0 {
	status = "okay";
};

&pcie_phy1 {
	status = "okay";
};

&pcie0_rc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie0_1>;
	num-lanes = <4>;
	phys = <&pcie_phy0>, <&pcie_phy1>;
	phy-names = "pcie-phy0", "pcie-phy1";
	spacemit,device-detect = <&gpio 89 0>;

	status = "okay";
};

&pcie1_rc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie1_1>;

	phys = <&pcie_phy1>;
	phy-names = "pcie-phy0";
	status = "okay";
};

&usb2_host_u2phy {
	status = "okay";
};

&usb2_host {
	status = "okay";
};

&usb3_porta_u2phy {
	status = "okay";
};

&usb3_porta_u3phy {
	/* dual phy selection is auto detect from GPIO86(SS_SW_3V3) */
	pinctrl-names = "default";
	pinctrl-0 = <&usb30_drd_dir_0_cfg>;
	status = "okay";
};

&usb3_porta {
	status = "okay";
	u-boot,dm-spl;
	dwc3@cad00000 {
		dr_mode = "peripheral";
		u-boot,dm-spl;
	};
};

&usb3_portd_u2phy {
	status = "okay";
};

&usb3_portd_u3phy {
       status = "okay";
};

&usb3_portd {
	/* TypeC (USB3/DP/Power) (with ANX7447 chip) */
	status = "okay";
};

&ufs {
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <26500000>;
		m25p,fast-read;
		broken-flash-reset;
		status = "okay";
	};
};

&espi0{
	status = "okay";

	ec: ec@0 {
		compatible = "google,cros-ec-espi";
		reg = <0x0>;

		/* eSPI VW GPIO interrupt configuration */
		espi-vw-gpio-wire = <0>;       /* Wire 0 within the group */
		espi-vw-gpio-index = <0x82>;   /* VM index 0x82 (Group 2/130) */

		i2c_tunnel: i2c-tunnel {
			compatible = "google,cros-ec-i2c-tunnel";
			#address-cells = <1>;
			#size-cells = <0>;
			google,remote-bus = <1>;

			rt7451: retimer@13 {
				compatible = "retimer,rt7451";
				reg = <0x13>;
				primary-addr = <0x13>;
				secondary-addr = <0x29>;
				status = "okay";
			};
		};
	};
};

&i2c8 {
	clock-frequency = <100000>;
	u-boot,dm-spl;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c8>;
	spacemit,sda-glitch-nofix;
	status = "okay";

	spm8821: pmic@41 {
		compatible = "spacemit,spm8821";
		reg = <0x41>;
		bus = <8>;
		u-boot,dm-spl;

		regulators {
			/* buck */
			dcdc_1: DCDC_REG1 {
				regulator-name = "dcdc1";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				/* regulator-init-microvolt = <1050000>; */
				regulator-always-on;
				regulator-boot-on;
				u-boot,dm-spl;
			};

			dcdc_2: DCDC_REG2 {
				regulator-name = "dcdc2";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dcdc_3: DCDC_REG3 {
				regulator-name = "dcdc3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-always-on;
				regulator-boot-on;
				u-boot,dm-spl;
			};

			dcdc_4: DCDC_REG4 {
				regulator-name = "dcdc4";
				regulator-min-microvolt = <2100000>;
				regulator-max-microvolt = <2100000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dcdc_5: DCDC_REG5 {
				regulator-name = "dcdc5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dcdc_6: DCDC_REG6 {
				regulator-name = "dcdc6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <600000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* aldo */
			ldo_1: LDO_REG1 {
				regulator-name = "ldo1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				/* regulator-init-microvolt = <3300000>; */
				regulator-always-on;
				regulator-boot-on;
				u-boot,dm-spl;
			};

			ldo_2: LDO_REG2 {
				regulator-name = "ldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo_3: LDO_REG3 {
				regulator-name = "ldo3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
			};

			ldo_4: LDO_REG4 {
				regulator-name = "ldo4";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* dldo */
			ldo_5: LDO_REG5 {
				regulator-name = "ldo5";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo_6: LDO_REG6 {
				regulator-name = "ldo6";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo_7: LDO_REG7 {
				regulator-name = "ldo7";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo_8: LDO_REG8 {
				regulator-name = "ldo8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			ldo_9: LDO_REG9 {
				regulator-name = "ldo9";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo_10: LDO_REG10 {
				regulator-name = "ldo10";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo_11: LDO_REG11 {
				regulator-name = "ldo11";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			sw_2: SWITCH_REG1 {
				regulator-name = "switch1";
			};

			power_event: SWITCH_REG2 {
				regulator-name = "pwr-event";
			};

			power_int: SWITCH_REG3 {
				regulator-name = "pwr-int";
			};

			rtc_ctrl: SWITCH_REG4 {
				regulator-name = "rtc-ctrl";
			};

			rtc_event: SWITCH_REG5 {
				regulator-name = "rtc-event";
			};

			rtc_irq: SWITCH_REG6 {
				regulator-name = "rtc-irq";
			};

			power_down: SWITCH_REG7 {
				regulator-name = "power-down";
			};

			reboot_flag: SWITCH_REG8 {
				regulator-name = "reboot-flag";
			};

			wdt_pm8821: PMIC_WDT {
				wdt-name = "wdt_pm8821";
			};
		};
	};

	au4562: au4562@75 {
		compatible = "spacemit,au4562";
		reg = <0x75>;
		bus = <8>;
		u-boot,dm-spl;

		regulators {
			u-boot,dm-spl;

			au4562_adcdc_1: ADCDC_REG1 {
				regulator-name = "adcdc1";
				regulator-min-microvolt = <540000>;
				regulator-max-microvolt = <1000000>;
				regulator-init-microvolt = <950000>;
				regulator-boot-on;
				u-boot,dm-spl;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			au4562_adcdc_2: ADCDC_REG2 {
				regulator-name = "adcdc2";
				regulator-min-microvolt = <540000>;
				regulator-max-microvolt = <1000000>;
				regulator-init-microvolt = <950000>;
				regulator-boot-on;
				u-boot,dm-spl;
				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&dpu {
	status = "okay";

	dpu_out: port {
		#address-cells = <1>;
		#size-cells = <0>;

		dpu_out_dp1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp1_in_dpu>;
		};
	};

};

&dp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_dp1_1>;
	status = "okay";

	ports {
		dp1_in: port {
			#address-cells = <1>;
			#size-cells = <0>;
			dp1_in_dpu: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dpu_out_dp1>;
			};
		};
	};
};

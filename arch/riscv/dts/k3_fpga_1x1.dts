#include "k3.dtsi"
#include "k3-pinctrl.dtsi"
#include "k1-x_spm8821.dtsi"

&uart0 {
	status = "okay";
};

&sdhci0 {
	bus-width = <4>;
	broken-cd;
	no-1-8-v;
	cap-sd-highspeed;
	sdh-phy-module = <0>;
	status = "disabled";
};

/* eMMC */
&sdhci2 {
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	sdh-phy-module = <1>;
	status = "disabled";
};

&eth0 {
	phy-reset-pin = <40>;
	max-speed = <100>;
	clk_tuning_enable;
	clk-tuning-by-reg;
	tx-phase = <10>;
	rx-phase = <40>;

	phy-mode = "rgmii";
	phy-addr = <0>;
	phy-handle = <&rgmii>;
	ref-clock-from-phy;

	status = "okay";

	mdio {
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		rgmii: phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			reg = <0x0>;
		};
	};
};

&usb3_porta {
	status = "disabled";
	u-boot,dm-spl;
	dwc3@cad00000 {
		dr_mode = "peripheral";
		maximum-speed = "high-speed";
		phy_type = "utmi_wide";
		snps,dis_enblslpm_quirk;
		snps,dis_u2_susphy_quirk;
		u-boot,dm-spl;
	};
};
